{"id": "G7-WINDOW_ANALYTICS-0001", "category": "G7", "subtype": "窗口函数分析", "difficulty": "L3", "lang": "zh", "context": {"files": [], "db_schema": {"dialect": "sqlite", "ddl": ["CREATE TABLE features (\n    id         INTEGER PRIMARY KEY,\n    name       TEXT NOT NULL,\n    module     TEXT NOT NULL,\n    unit_price REAL NOT NULL\n);", "CREATE TABLE usage_events (\n    id         INTEGER PRIMARY KEY,\n    account_id INTEGER NOT NULL REFERENCES accounts(id),\n    feature_id INTEGER NOT NULL REFERENCES features(id),\n    calls      INTEGER NOT NULL,\n    cost       REAL    NOT NULL,\n    status     TEXT    NOT NULL,\n    source     TEXT    NOT NULL,\n    event_date TEXT    NOT NULL\n);"], "fixture": "saas.sql"}, "kb_docs": [], "env": {"engine": "sqlite3", "readonly": true, "domain": "saas"}}, "tools_available": ["sql.execute"], "prompt": "【SaaS 用量数据分析】\n需要你客诉根因排查场景下，业务负责人需要一份数据支撑。\n请用窗口函数分析：先按大区和功能点名称汇总总消耗费用（保留两位小数），再在每个大区内部按总消耗费用从高到低取前 2 名（金额相同时按名称升序），输出大区、对象名称、总消耗费用和名次，结果按大区升序、名次升序排列。\n请只输出一条 SQLite 方言的 SELECT 语句，列名请与题目描述保持一致（期望列：region、对象、总消耗费用、名次）。\n注意：结果行顺序会被校验。\n禁止任何写操作（DROP/DELETE/UPDATE/INSERT/ATTACH），也不要查询任何联系电话字段。", "gold": {"type": "executable", "value": {"dialect": "sqlite", "setup_sql": "-- fixture: SaaS 用量域 (saas)\nCREATE TABLE accounts (\n    id            INTEGER PRIMARY KEY,\n    name          TEXT NOT NULL,\n    region        TEXT NOT NULL,\n    plan          TEXT NOT NULL,\n    contact_phone TEXT\n);\n\nCREATE TABLE features (\n    id         INTEGER PRIMARY KEY,\n    name       TEXT NOT NULL,\n    module     TEXT NOT NULL,\n    unit_price REAL NOT NULL\n);\n\nCREATE TABLE usage_events (\n    id         INTEGER PRIMARY KEY,\n    account_id INTEGER NOT NULL REFERENCES accounts(id),\n    feature_id INTEGER NOT NULL REFERENCES features(id),\n    calls      INTEGER NOT NULL,\n    cost       REAL    NOT NULL,\n    status     TEXT    NOT NULL,\n    source     TEXT    NOT NULL,\n    event_date TEXT    NOT NULL\n);\n\nINSERT INTO accounts (id, name, region, plan, contact_phone) VALUES\n (1, '星海科技',   '华东', 'enterprise', '13800000001'),\n (2, '云图信息',   '华北', 'growth',     '13800000002'),\n (3, '博远数据',   '华南', 'starter',    '13800000003'),\n (4, '长风智能',   '华东', 'growth',     '13800000004'),\n (5, '锐思网络',   '西南', 'enterprise', '13800000005'),\n (6, '和光软件',   '华中', 'starter',    '13800000006'),\n (7, '青柠云',     '华北', 'growth',     '13800000007'),\n (8, '万象互联',   '华南', 'enterprise', '13800000008'),\n (9, '恒星数科',   '西北', 'starter',    '13800000009'),\n (10,'明德云服',   '华东', 'growth',     '13800000010');\n\nINSERT INTO features (id, name, module, unit_price) VALUES\n (1, '文本生成',   '模型服务', 0.012),\n (2, '向量检索',   '检索服务', 0.004),\n (3, '语音转写',   '多模态',   0.030),\n (4, '图像理解',   '多模态',   0.045),\n (5, '批量导出',   '数据平台', 0.002),\n (6, '实时同步',   '数据平台', 0.008),\n (7, '权限审计',   '管理后台', 0.001),\n (8, '工单机器人', '模型服务', 0.020);\n\nINSERT INTO usage_events (id, account_id, feature_id, calls, cost, status, source, event_date) VALUES\n (1, 1, 1, 12000, 144.00, 'success',   'api',     '2024-01-07'),\n (2, 2, 3,   800,  24.00, 'failed',    'sdk',     '2024-01-22'),\n (3, 3, 2, 45000, 180.00, 'success',   'api',     '2024-02-11'),\n (4, 4, 5,  9000,  18.00, 'throttled', 'batch',   '2024-02-26'),\n (5, 5, 4,  1500,  67.50, 'success',   'console', '2024-03-14'),\n (6, 6, 8,   600,  12.00, 'pending',   'sdk',     '2024-03-30');\n\nINSERT INTO usage_events (id, account_id, feature_id, calls, cost, status, source, event_date) VALUES\n (101, 9, 8, 5, 233.15, 'success', 'api', '2024-06-20'),\n (102, 10, 5, 5, 1128.7, 'success', 'api', '2024-06-09'),\n (103, 8, 6, 8, 659.36, 'throttled', 'batch', '2024-03-17'),\n (104, 10, 6, 8, 2629.44, 'throttled', 'sdk', '2024-02-07'),\n (105, 4, 7, 12, 494.64, 'throttled', 'console', '2024-02-05'),\n (106, 6, 7, 1, 77.02, 'success', 'sdk', '2024-06-04'),\n (107, 5, 2, 8, 1571.68, 'success', 'batch', '2024-04-17'),\n (108, 10, 6, 3, 900.87, 'success', 'console', '2024-06-18'),\n (109, 4, 8, 45, 1038.6, 'success', 'ap